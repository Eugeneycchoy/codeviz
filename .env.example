# NextAuth.js (required in production — app will throw at startup if missing)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# GitHub OAuth (required in production if using GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (required in production if using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side admin)
SUPABASE_SERVICE_ROLE_KEY=

# Poe API (AI explanations in /api/explain)
POE_API_KEY=
